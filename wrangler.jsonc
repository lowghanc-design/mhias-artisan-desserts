// Cloudflare deploy settings.
// public/  = the website (HTML, CSS, images, JS) served as static files
// src/     = the small server that creates Square checkouts (/api/*)
{
  "name": "mhias-artisan-desserts",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // "sandbox" for test payments, "production" for real ones
    "SQUARE_ENV": "sandbox",
    // Square location (shown in the Square Developer dashboard)
    "SQUARE_LOCATION_ID": "L5CGB1HKEM4HJ",
    // Max paid orders per pickup day, and how many of them may include a custom cake
    "DAILY_ORDER_CAP": "15",
    "DAILY_CAKE_CAP": "3",
    "SITE_URL": "https://mhiasartisandesserts.com"
  },
  // Settings for preview links (test copies of a branch). Always Square sandbox.
  "previews": {
    "vars": {
      "SQUARE_ENV": "sandbox",
      "SQUARE_LOCATION_ID": "L5CGB1HKEM4HJ",
      "DAILY_ORDER_CAP": "15",
      "DAILY_CAKE_CAP": "3",
      "SITE_URL": ""
    }
  }
  // The Square access token is a secret: it is NOT stored here.
  // Local testing: put SQUARE_ACCESS_TOKEN=... in a .dev.vars file (never committed).
  // Live site: Cloudflare dashboard -> this Worker -> Settings -> Variables and Secrets.
}
